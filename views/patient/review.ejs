<%- include("../partials/header") %>

    <div class="min-h-screen bg-slate-50 py-12 px-4">
        <div class="max-w-2xl mx-auto">

            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8">

                <div class="mb-8">
                    <h1 class="text-2xl font-bold text-slate-800">
                        Write a Review
                    </h1>
                    <p class="text-sm text-slate-500 mt-2">
                        Share your experience to help other patients.
                    </p>
                </div>

                <!-- Appointment Details -->
                <div class="rounded-xl bg-blue-50 border border-blue-100 p-4 mb-8">
                    <p class="text-sm text-slate-500 mb-1">Doctor</p>

                    <h2 class="text-lg font-semibold text-slate-800">
                        Dr. <%= appointment.doctor.user.name %>
                    </h2>

                    <p class="text-sm text-slate-600 mt-2">
                        Appointment Date: <%= appointment.date %>
                    </p>

                    <p class="text-sm text-slate-600">
                        Time: <%= appointment.startTime %> - <%= appointment.endTime %>
                    </p>
                </div>

                <!-- Review Form -->
                <form action="/patients/appointments/<%= appointment._id %>/review" method="POST" class="space-y-6">

                    <!-- Rating -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-3">
                            Your Rating <span class="text-red-500">*</span>
                        </label>

                        <div class="flex flex-wrap gap-4">

                            <% for (let i=1; i <=5; i++) { %>
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input type="radio" name="rating" value="<%= i %>" required
                                        class="accent-indigo-600">

                                    <span class="text-sm font-medium text-slate-700">
                                        <%= i %> <i class="fa-solid fa-star text-yellow-400"></i>
                                    </span>
                                </label>
                                <% } %>

                        </div>
                    </div>

                    <!-- Comment -->
                    <div>
                        <label for="comment" class="block text-sm font-semibold text-slate-700 mb-2">
                            Your Experience
                            <span class="text-slate-400 font-normal">(Optional)</span>
                        </label>

                        <textarea id="comment" name="comment" rows="5" maxlength="500"
                            placeholder="Share your experience with the doctor..."
                            class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none"></textarea>

                        <p class="text-xs text-slate-400 mt-2">
                            Maximum 500 characters.
                        </p>
                    </div>

                    <!-- Buttons -->
                    <div class="flex flex-col sm:flex-row gap-3 pt-2">

                        <button type="submit"
                            class="flex-1 rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white hover:bg-indigo-700 transition">
                            <i class="fa-solid fa-paper-plane mr-2"></i>
                            Submit Review
                        </button>

                        <a href="/patients/appointments"
                            class="flex-1 text-center rounded-xl border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>
    </div>

    <%- include("../partials/footer") %>