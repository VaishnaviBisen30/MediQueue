<%- include("./partials/patientHeader", { pageTitle: "Reschedule Appointment | MediQueue" }) %>

    <main class="flex-1 max-w-4xl mx-auto w-full px-6 py-10">

        <a href="/patients/appointments"
            class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 hover:text-indigo-800 transition">
            ← Back to My Appointments
        </a>

        <section class="mt-6 bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm">

            <p class="text-sm font-semibold text-indigo-600">
                APPOINTMENT RESCHEDULING
            </p>

            <h1 class="text-3xl font-bold text-slate-800 mt-2">
                Reschedule Appointment
            </h1>

            <p class="text-slate-600 mt-2">
                Dr. <%= appointment.doctor?.user?.name || "Doctor" %>
            </p>

            <p class="text-sm text-slate-500 mt-1">
                <%= appointment.doctor?.specialization || "Specialization unavailable" %>
            </p>

            <!-- Current Appointment Details -->
            <div class="mt-6 rounded-xl border border-indigo-100 bg-indigo-50 p-5">

                <h2 class="font-semibold text-indigo-900">
                    Current Appointment
                </h2>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">

                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wide text-indigo-500">
                            Current Date
                        </p>
                        <p class="font-bold text-slate-800 mt-1">
                            <%= appointment.date %>
                        </p>
                    </div>

                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wide text-indigo-500">
                            Current Time
                        </p>
                        <p class="font-bold text-slate-800 mt-1">
                            <%= appointment.startTime %> – <%= appointment.endTime %>
                        </p>
                    </div>

                </div>
            </div>

            <!-- New Date Selection -->
            <div class="mt-8">

                <h2 class="text-xl font-semibold text-slate-800">
                    Select a New Date
                </h2>

                <p class="text-sm text-slate-500 mt-2">
                    Choose a new date for your appointment. Available time slots will be shown next.
                </p>

                <label for="newDate" class="block text-sm font-medium text-slate-700 mt-5 mb-2">
                    New Appointment Date
                </label>

                <input type="date" id="newDate" name="date"
                    min="<%= new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' }) %>" required
                    class="w-full sm:max-w-md rounded-xl border border-slate-300 px-3 py-3 text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />

                <div id="slotsContainer" class="mt-6"></div>

            </div>

        </section>

    </main>

    <script>
        const dateInput = document.getElementById("newDate");
        const slotsContainer = document.getElementById("slotsContainer");

        dateInput.addEventListener("change", async () => {
            const selectedDate = dateInput.value;

            slotsContainer.innerHTML = "";

            if (!selectedDate) return;

            slotsContainer.innerHTML = `
            <p class="text-sm text-slate-500">
                Loading available slots...
            </p>
        `;

            try {
                const response = await fetch(
                    `/patients/appointments/<%= appointment._id %>/available-slots?date=${encodeURIComponent(selectedDate)}`
                );

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.message || "Unable to fetch slots.");
                }

                if (data.slots.length === 0) {
                    slotsContainer.innerHTML = `
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-5 text-center">
                        <p class="text-slate-600">
                            ${data.message || "No available slots for this date."}
                        </p>
                    </div>
                `;
                    return;
                }

                let html = `
                <h2 class="text-xl font-semibold text-slate-800 mb-4">
                    Available Slots - ${data.day}
                </h2>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            `;

                data.slots.forEach(slot => {
                    html += `
                    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                        <div class="flex items-center gap-3">
                            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
                                <i class="fa-regular fa-clock text-lg"></i>
                            </div>

                            <div>
                                <p class="font-semibold text-slate-800">
                                    ${slot.startTime} – ${slot.endTime}
                                </p>

                                <p class="text-sm text-slate-500 mt-1">
                                    30-minute appointment
                                </p>
                            </div>
                        </div>

                        <form action="/patients/appointments/<%= appointment._id %>/reschedule"
                            method="POST"
                            class="mt-5">

                            <input type="hidden" name="date" value="${selectedDate}">
                            <input type="hidden" name="day" value="${data.day}">
                            <input type="hidden" name="startTime" value="${slot.startTime}">

                            <button type="submit"
                                class="mt-2 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white hover:bg-indigo-700 transition">

                                Reschedule to ${slot.startTime}
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>

                        </form>
                    </div>
                `;
                });

                html += `</div>`;

                slotsContainer.innerHTML = html;

            } catch (error) {
                console.error("Error loading slots:", error);

                slotsContainer.innerHTML = `
                <p class="rounded-xl bg-red-50 p-4 text-sm text-red-600">
                    ${error.message}
                </p>
            `;
            }
        });
    </script>

    <%- include("../partials/footer") %>