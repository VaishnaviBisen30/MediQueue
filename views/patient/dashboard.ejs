<%- include("./partials/patientHeader", { pageTitle: "Patient Dashboard | MediQueue" }) %>

    <main class="flex-1 w-full">
        <div class="max-w-6xl mx-auto px-6 py-10">


            <section class="mb-10">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-indigo-600 font-semibold text-sm">
                            PATIENT PORTAL
                        </p>

                        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-2">
                            Welcome to MediQueue!
                        </h1>

                        <p class="text-slate-500 mt-3">
                            Find the right doctor and manage your healthcare appointments in one place.
                        </p>
                    </div>


                    <a href="/patients/notifications" aria-label="View notifications" title="Notifications"
                        class="relative shrink-0 inline-flex items-center justify-center w-12 h-12 rounded-xl border border-slate-200 bg-white text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 hover:border-indigo-200 transition-colors shadow-sm">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 00-4.5-5.9V4a1.5 1.5 0 00-3 0v1.1A6 6 0 006 11v3.2a2 2 0 01-.6 1.4L4 17h5m6 0a3 3 0 01-6 0" />
                        </svg>

                        <% if (unreadNotifications> 0) { %>
                            <span
                                class="absolute -top-2 -right-2 min-w-5 h-5 px-1 rounded-full bg-rose-600 text-white text-xs font-bold flex items-center justify-center ring-2 ring-white">
                                <%= unreadNotifications> 99 ? "99+" : unreadNotifications %>
                            </span>
                            <% } %>
                    </a>
                </div>
            </section>


            <!-- Appointment Summary -->
            <section class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-10">

                <!-- Booked Appointments -->
                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                    <div
                        class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M8 7V3m8 4V3M5 11h14M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>

                    <p class="text-sm text-slate-500">Upcoming Appointments</p>

                    <h2 class="text-3xl font-bold text-slate-900 mt-2">
                        <%= upcomingAppointments %>
                    </h2>
                </div>

                <!-- Completed Appointments -->
                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                    <div
                        class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>

                    <p class="text-sm text-slate-500">Completed Appointments</p>

                    <h2 class="text-3xl font-bold text-slate-900 mt-2">
                        <%= completedAppointments %>
                    </h2>
                </div>

                <!-- Cancelled Appointments -->
                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                    <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </div>

                    <p class="text-sm text-slate-500">Cancelled Appointments</p>

                    <h2 class="text-3xl font-bold text-slate-900 mt-2">
                        <%= cancelledAppointments %>
                    </h2>
                </div>

            </section>


            <!-- Next Upcoming Appointment -->
            <section class="mb-10">
                <h2 class="text-2xl font-bold text-slate-900 mb-5">
                    Your Next Appointment
                </h2>

                <% if (nextAppointment) { %>
                    <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">

                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

                            <div>
                                <p class="text-sm font-semibold text-indigo-600 mb-2">
                                    UPCOMING VISIT
                                </p>

                                <h3 class="text-xl font-bold text-slate-800">
                                    Dr. <%= nextAppointment.doctor?.user?.name || "Doctor" %>
                                </h3>

                                <p class="text-slate-500 mt-1">
                                    <%= nextAppointment.doctor?.specialization || "Specialization not available" %>
                                </p>
                            </div>

                            <span
                                class="inline-flex w-fit items-center rounded-full bg-emerald-50 px-3 py-1 text-sm font-semibold text-emerald-700">
                                <%= nextAppointment.status %>
                            </span>

                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">

                            <div class="rounded-xl bg-slate-50 p-4">
                                <p class="text-sm text-slate-500">Appointment Date</p>
                                <p class="font-semibold text-slate-800 mt-1">
                                    <%= nextAppointment.date %>
                                </p>
                            </div>

                            <div class="rounded-xl bg-slate-50 p-4">
                                <p class="text-sm text-slate-500">Appointment Time</p>
                                <p class="font-semibold text-slate-800 mt-1">
                                    <%= nextAppointment.startTime %> - <%= nextAppointment.endTime %>
                                </p>
                            </div>

                        </div>

                        <a href="/patients/appointments"
                            class="inline-flex items-center gap-2 mt-6 text-sm font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">
                            View appointment details
                            <span>→</span>
                        </a>

                    </div>

                    <% } else { %>

                        <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-8 text-center">

                            <div
                                class="w-14 h-14 mx-auto rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-4">
                                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M8 7V3m8 4V3M5 11h14M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>

                            <h3 class="text-lg font-bold text-slate-800">
                                No upcoming appointments
                            </h3>

                            <p class="text-slate-500 text-sm mt-2">
                                You don't have any upcoming visits. Find a doctor to book your next appointment.
                            </p>

                            <a href="/patients/doctors"
                                class="inline-flex items-center justify-center mt-5 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white hover:bg-indigo-700 transition-colors">
                                Find a Doctor
                            </a>

                        </div>

                        <% } %>
            </section>


            <!-- Dashboard Navigation Cards -->
            <section class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Find a Doctor -->
                <a href="/patients/doctors"
                    class="group bg-white rounded-2xl border border-slate-200 p-7 shadow-sm hover:shadow-md hover:border-indigo-200 hover:-translate-y-1 transition-all duration-200">

                    <div
                        class="w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-6 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                    </div>

                    <h2 class="text-xl font-bold text-slate-800 group-hover:text-indigo-600 transition-colors">
                        Find a Doctor
                    </h2>

                    <p class="text-slate-500 mt-2 text-sm leading-relaxed">
                        Browse doctor profiles, explore specializations, and find the right specialist.
                    </p>

                    <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-indigo-600">
                        <span>Browse doctors</span>
                        <span class="transition-transform group-hover:translate-x-1">→</span>
                    </div>
                </a>

                <!-- My Appointments -->
                <a href="/patients/appointments"
                    class="group bg-white rounded-2xl border border-slate-200 p-7 shadow-sm hover:shadow-md hover:border-teal-200 hover:-translate-y-1 transition-all duration-200">

                    <div
                        class="w-14 h-14 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center mb-6 group-hover:bg-teal-600 group-hover:text-white transition-colors">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M8 7V3m8 4V3M5 11h14M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002-2v-12a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>

                    <h2 class="text-xl font-bold text-slate-800 group-hover:text-teal-600 transition-colors">
                        My Appointments
                    </h2>

                    <p class="text-slate-500 mt-2 text-sm leading-relaxed">
                        View your bookings, check appointment statuses, and manage your visits.
                    </p>

                    <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-teal-600">
                        <span>View appointments</span>
                        <span class="transition-transform group-hover:translate-x-1">→</span>
                    </div>
                </a>

            </section>

        </div>
    </main>

    <%- include("../partials/footer") %>