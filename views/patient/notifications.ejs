<%- include("./partials/patientHeader") %>

    <div class="max-w-4xl mx-auto px-4 py-8">

        <div class="mb-6">
            <p class="text-sm text-blue-600 font-semibold uppercase tracking-wide">
                Patient Portal
            </p>
            <h1 class="text-3xl font-bold text-gray-800 mt-1">
                My Notifications
            </h1>
            <p class="text-gray-500 mt-2">
                Stay updated on your appointments.
            </p>
        </div>

        <% if (notifications.length===0) { %>

            <div class="bg-white border border-gray-200 rounded-xl p-8 text-center">
                <h2 class="text-lg font-semibold text-gray-700">
                    No notifications yet
                </h2>
                <p class="text-gray-500 mt-2">
                    Appointment updates will appear here.
                </p>
            </div>

            <% } else { %>

                <div class="space-y-4">
                    <% notifications.forEach((notification)=> { %>

                        <div class="bg-white border rounded-xl p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4
          <%= notification.isRead ? 'border-gray-200' : 'border-blue-300 bg-blue-50' %>">

                            <div>
                                <p class="text-gray-800 font-medium">
                                    <%= notification.message %>
                                </p>

                                <p class="text-sm text-gray-500 mt-2">
                                    <%= new Date(notification.createdAt).toLocaleString("en-IN", { dateStyle: "medium" ,
                                        timeStyle: "short" , timeZone: "Asia/Kolkata" }) %>
                                </p>

                                <% if (!notification.isRead) { %>
                                    <span class="inline-block mt-2 text-xs font-semibold text-blue-700">
                                        New
                                    </span>
                                    <% } %>
                            </div>

                            <% if (!notification.isRead) { %>
                                <form action="/patients/notifications/<%= notification._id %>/read" method="POST">
                                    <button type="submit"
                                        class="px-4 py-2 text-sm font-medium text-blue-700 border border-blue-300 rounded-lg hover:bg-blue-100 transition">
                                        Mark as read
                                    </button>
                                </form>
                                <% } %>

                        </div>

                        <% }); %>
                </div>

                <% } %>

                    <div class="mt-6">
                        <a href="/patients/dashboard" class="text-blue-600 hover:text-blue-800 font-medium">
                            ← Back to Dashboard
                        </a>
                    </div>

    </div>

    <%- include("../partials/footer") %>