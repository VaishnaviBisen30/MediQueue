<%- include("partials/adminHeader", { pageTitle: "Admin Dashboard | MediQueue" }) %>

    <main class="flex-1 w-full">
        <div class="max-w-6xl mx-auto px-6 py-10">

            <!-- Dashboard Heading -->
            <section class="mb-10">
                <p class="text-indigo-600 font-semibold text-sm">
                    ADMIN PORTAL
                </p>

                <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-2">
                    Welcome to MediQueue!
                </h1>

                <p class="text-slate-500 mt-3">
                    Manage doctor registrations, patient accounts, and healthcare appointments in one place.
                </p>
            </section>

            <!-- Dashboard Cards -->
            <section class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Manage Doctors -->
                <a href="/admin/doctors"
                    class="group bg-white rounded-2xl border border-slate-200 p-7 shadow-sm hover:shadow-md hover:border-indigo-200 hover:-translate-y-1 transition-all duration-200">

                    <div
                        class="w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-6 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                    </div>

                    <h2 class="text-xl font-bold text-slate-800 group-hover:text-indigo-600 transition-colors">
                        Manage Doctors
                    </h2>

                    <p class="text-slate-500 mt-2 text-sm leading-relaxed">
                        Review doctor registrations, verify qualifications, and approve or reject doctor applications.
                    </p>

                    <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-indigo-600">
                        <span>Review doctors</span>
                        <span class="transition-transform group-hover:translate-x-1">→</span>
                    </div>
                </a>

                <!-- Manage Patients -->
                <a href="/admin/patients"
                    class="group bg-white rounded-2xl border border-slate-200 p-7 shadow-sm hover:shadow-md hover:border-teal-200 hover:-translate-y-1 transition-all duration-200">

                    <div
                        class="w-14 h-14 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center mb-6 group-hover:bg-teal-600 group-hover:text-white transition-colors">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 20h5v-2a4 4 0 00-5-3.87M9 20H2v-2a4 4 0 015-3.87M16 3.13a4 4 0 010 7.75M8 3.13a4 4 0 000 7.75M12 14a4 4 0 100-8 4 4 0 000 8z" />
                        </svg>
                    </div>

                    <h2 class="text-xl font-bold text-slate-800 group-hover:text-teal-600 transition-colors">
                        Manage Patients
                    </h2>

                    <p class="text-slate-500 mt-2 text-sm leading-relaxed">
                        View registered patient accounts and manage patient records.
                    </p>

                    <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-teal-600">
                        <span>View patients</span>
                        <span class="transition-transform group-hover:translate-x-1">→</span>
                    </div>
                </a>

                <!-- Manage Appointments -->
                <a href="/admin/appointments"
                    class="group bg-white rounded-2xl border border-slate-200 p-7 shadow-sm hover:shadow-md hover:border-amber-200 hover:-translate-y-1 transition-all duration-200">

                    <div
                        class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mb-6 group-hover:bg-amber-500 group-hover:text-white transition-colors">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M8 7V3m8 4V3M5 11h14M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>

                    <h2 class="text-xl font-bold text-slate-800 group-hover:text-amber-600 transition-colors">
                        Manage Appointments
                    </h2>

                    <p class="text-slate-500 mt-2 text-sm leading-relaxed">
                        Review scheduled appointments and monitor their status across the platform.
                    </p>

                    <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-amber-600">
                        <span>View appointments</span>
                        <span class="transition-transform group-hover:translate-x-1">→</span>
                    </div>
                </a>



                <!-- Admin Overview -->
                <a href="/admin/overview"
                    class="group bg-white rounded-2xl border border-slate-200 p-7 shadow-sm hover:shadow-md hover:border-rose-200 hover:-translate-y-1 transition-all duration-200">

                    <div
                        class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mb-6 group-hover:bg-rose-600 group-hover:text-white transition-colors">

                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 12l2 2 4-4m5.6-2A11.05 11.05 0 0112 3a11.05 11.05 0 01-8.6 5A12 12 0 0012 21a12 12 0 008.6-13z" />
                        </svg>
                    </div>

                    <h2 class="text-xl font-bold text-slate-800 group-hover:text-rose-600 transition-colors">
                        Platform Overview
                    </h2>

                    <p class="text-slate-500 mt-2 text-sm leading-relaxed">
                        View platform statistics, doctor verification, patient registrations,
                        and appointment activity across MediQueue.
                    </p>

                    <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-rose-600">
                        <span>View overview</span>
                        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                    </div>
                </a>

            </section>
        </div>
    </main>

    <%- include("../partials/footer") %>