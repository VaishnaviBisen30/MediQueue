<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= typeof pageTitle !=="undefined" ? pageTitle : "Admin Dashboard | MediQueue" %>
    </title>

    <!-- Replace this path with the exact CSS path used in patientHeader.ejs -->
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="min-h-screen bg-slate-100 flex flex-col">

    <header class="bg-white border-b border-slate-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

            <!-- Logo -->
            <a href="/admin/dashboard" class="flex items-center gap-3">
                <div
                    class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-lg">
                    M
                </div>

                <div>
                    <h1 class="text-xl font-bold text-slate-800">MediQueue</h1>
                    <p class="text-xs font-medium text-blue-600">ADMIN PANEL</p>
                </div>
            </a>

            <!-- Navigation -->
            <nav class="flex flex-wrap items-center gap-3 sm:gap-5">
                <a href="/admin/dashboard" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition">
                    Dashboard
                </a>

                <a href="/admin/doctors" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition">
                    Manage Doctors
                </a>

                <a href="/admin/patients" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition">
                    Patients
                </a>

                <a href="/admin/appointments" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition">
                    Appointments
                </a>

                <a href="/logout"
                    class="rounded-lg bg-red-500 px-4 py-2 text-sm font-semibold text-white hover:bg-red-600 transition">
                    Logout
                </a>
            </nav>

        </div>
    </header>