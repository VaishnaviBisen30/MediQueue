<%- include("partials/adminHeader", { pageTitle: "Platform Overview | MediQueue" }) %>

    <main class="flex-1 w-full bg-slate-50">
        <div class="max-w-6xl mx-auto px-6 py-10">

            <!-- Page Header -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-8">
                <div>
                    <h1 class="text-3xl font-bold text-slate-800">
                        Platform Overview
                    </h1>
                    <p class="text-slate-500 mt-2">
                        Monitor users, doctor verification, and appointment activity across MediQueue.
                    </p>
                </div>

                <a href="/admin/dashboard"
                    class="inline-block px-5 py-2 rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-100">
                    Back to Dashboard
                </a>
            </div>

            <!-- Main Statistics -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">

                <!-- Total Patients -->
                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                    <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 20h5v-2a3 3 0 00-5.5-1.7M9 20H4v-2a3 3 0 015.5-1.7M16 3.1a4 4 0 010 7.8M8 3.1a4 4 0 000 7.8" />
                        </svg>
                    </div>
                    <p class="text-sm text-slate-500">Total Patients</p>
                    <h2 class="text-3xl font-bold text-slate-800 mt-2">
                        <%= totalPatients %>
                    </h2>
                    <a href="/admin/patients"
                        class="inline-block mt-4 text-sm font-semibold text-blue-600 hover:underline">
                        View Patients →
                    </a>
                </div>

                <!-- Total Doctors -->
                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                    <div
                        class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 14v7m-4 0h8m-8-7a4 4 0 01-4-4V5h8v5a4 4 0 01-4 4zm4-4h4a3 3 0 003-3V5h-3" />
                        </svg>
                    </div>
                    <p class="text-sm text-slate-500">Total Doctor Profiles</p>
                    <h2 class="text-3xl font-bold text-slate-800 mt-2">
                        <%= totalDoctors %>
                    </h2>
                    <a href="/admin/doctors"
                        class="inline-block mt-4 text-sm font-semibold text-purple-600 hover:underline">
                        Manage Doctors →
                    </a>
                </div>

                <!-- Pending Approvals -->
                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                    <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <p class="text-sm text-slate-500">Pending Approvals</p>
                    <h2 class="text-3xl font-bold text-slate-800 mt-2">
                        <%= pendingApprovals %>
                    </h2>
                    <a href="/admin/doctors"
                        class="inline-block mt-4 text-sm font-semibold text-amber-600 hover:underline">
                        Review Requests →
                    </a>
                </div>

                <!-- Total Appointments -->
                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                    <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M8 7V3m8 4V3M4 11h16M5 5h14a1 1 0 011 1v13H4V6a1 1 0 011-1z" />
                        </svg>
                    </div>
                    <p class="text-sm text-slate-500">Total Appointments</p>
                    <h2 class="text-3xl font-bold text-slate-800 mt-2">
                        <%= totalAppointments %>
                    </h2>
                    <a href="/admin/appointments"
                        class="inline-block mt-4 text-sm font-semibold text-rose-600 hover:underline">
                        View Appointments →
                    </a>
                </div>

            </div>

            <!-- Appointment Status Breakdown -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 mb-8">
                <h2 class="text-xl font-bold text-slate-800 mb-6">
                    Appointment Status Overview
                </h2>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">

                    <div class="rounded-xl bg-amber-50 border border-amber-100 p-5">
                        <p class="text-sm font-medium text-amber-700">Booked</p>
                        <p class="text-2xl font-bold text-amber-800 mt-2">
                            <%= bookedAppointments %>
                        </p>
                    </div>

                    <div class="rounded-xl bg-green-50 border border-green-100 p-5">
                        <p class="text-sm font-medium text-green-700">Completed</p>
                        <p class="text-2xl font-bold text-green-800 mt-2">
                            <%= completedAppointments %>
                        </p>
                    </div>

                    <div class="rounded-xl bg-red-50 border border-red-100 p-5">
                        <p class="text-sm font-medium text-red-700">Cancelled</p>
                        <p class="text-2xl font-bold text-red-800 mt-2">
                            <%= cancelledAppointments %>
                        </p>
                    </div>

                </div>
            </div>

            <!-- Doctor Verification Overview -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                <h2 class="text-xl font-bold text-slate-800 mb-6">
                    Doctor Verification Overview
                </h2>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">

                    <div class="rounded-xl bg-green-50 border border-green-100 p-5">
                        <p class="text-sm font-medium text-green-700">Approved Doctors</p>
                        <p class="text-2xl font-bold text-green-800 mt-2">
                            <%= approvedDoctors %>
                        </p>
                    </div>

                    <div class="rounded-xl bg-amber-50 border border-amber-100 p-5">
                        <p class="text-sm font-medium text-amber-700">Pending Doctors</p>
                        <p class="text-2xl font-bold text-amber-800 mt-2">
                            <%= pendingApprovals %>
                        </p>
                    </div>

                    <div class="rounded-xl bg-red-50 border border-red-100 p-5">
                        <p class="text-sm font-medium text-red-700">Rejected Doctors</p>
                        <p class="text-2xl font-bold text-red-800 mt-2">
                            <%= rejectedDoctors %>
                        </p>
                    </div>

                </div>
            </div>

        </div>
    </main>

    <%- include("../partials/footer") %>