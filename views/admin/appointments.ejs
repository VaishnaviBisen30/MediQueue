<%- include("partials/adminHeader", { pageTitle: "Manage Appointments | MediQueue" }) %>

    <main class="flex-1 w-full">
        <div class="max-w-6xl mx-auto px-6 py-10">

            <!-- Page Header -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-8">
                <div>
                    <h1 class="text-3xl font-bold text-gray-800">Manage Appointments</h1>
                    <p class="text-gray-500 mt-2">
                        View and monitor all patient appointments.
                    </p>
                </div>

                <a href="/admin/dashboard"
                    class="inline-block px-5 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100">
                    Back to Dashboard
                </a>
            </div>

            <!-- Appointments Table -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">

                <% if (appointments.length===0) { %>
                    <div class="p-8 text-center">
                        <h2 class="text-lg font-semibold text-gray-700">
                            No appointments found
                        </h2>
                        <p class="text-gray-500 mt-2">
                            Appointments will appear here when patients book them.
                        </p>
                    </div>
                    <% } else { %>

                        <table class="w-full text-left">
                            <thead class="bg-gray-50 border-b border-gray-200">
                                <tr>
                                    <th class="px-6 py-4 text-sm font-semibold text-gray-600">Patient</th>
                                    <th class="px-6 py-4 text-sm font-semibold text-gray-600">Doctor</th>
                                    <th class="px-6 py-4 text-sm font-semibold text-gray-600">Date</th>
                                    <th class="px-6 py-4 text-sm font-semibold text-gray-600">Time</th>
                                    <th class="px-6 py-4 text-sm font-semibold text-gray-600">Status</th>
                                </tr>
                            </thead>

                            <tbody class="divide-y divide-gray-200">
                                <% appointments.forEach((appointment)=> { %>
                                    <tr>
                                        <!-- Patient -->
                                        <td class="px-6 py-4">
                                            <p class="font-medium text-gray-800">
                                                <%= appointment.patient && appointment.patient.name ?
                                                    appointment.patient.name : "Unknown Patient" %>
                                            </p>
                                            <p class="text-sm text-gray-500">
                                                <%= appointment.patient && appointment.patient.email ?
                                                    appointment.patient.email : "No email" %>
                                            </p>
                                        </td>

                                        <!-- Doctor -->
                                        <td class="px-6 py-4">
                                            <p class="font-medium text-gray-800">
                                                <%= appointment.doctor && appointment.doctor.user ?
                                                    appointment.doctor.user.name : "Unknown Doctor" %>
                                            </p>

                                            <p class="text-sm text-gray-500">
                                                <%= appointment.doctor && appointment.doctor.specialization ?
                                                    appointment.doctor.specialization : "N/A" %>
                                            </p>
                                        </td>

                                        <!-- Appointment Date -->
                                        <td class="px-6 py-4 text-gray-700">
                                            <%= appointment.date || "N/A" %>
                                        </td>

                                        <!-- Appointment Time -->
                                        <td class="px-6 py-4 text-gray-700 whitespace-nowrap">
                                            <%= appointment.startTime || "N/A" %>
                                                -
                                                <%= appointment.endTime || "N/A" %>
                                        </td>

                                        <!-- Appointment Status -->
                                        <td class="px-6 py-4">
                                            <% const status=appointment.status || "booked" ; %>

                                                <span class="px-3 py-1 rounded-full text-sm
                                        <%= status === 'completed'
                                            ? 'bg-green-100 text-green-700'
                                            : status === 'cancelled'
                                            ? 'bg-red-100 text-red-700'
                                            : 'bg-yellow-100 text-yellow-700' %>">
                                                    <%= status.charAt(0).toUpperCase() + status.slice(1) %>
                                                </span>
                                        </td>
                                    </tr>
                                    <% }); %>
                            </tbody>
                        </table>

                        <% } %>
            </div>
        </div>
    </main>

    <%- include("../partials/footer") %>