<%- include("./partials/doctorHeader") %>

    <div class="min-h-[calc(100vh-4rem)] bg-slate-50">

        <div class="max-w-4xl mx-auto px-6 py-12">

            <!-- Header -->

            <div class="mb-10">

                <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                    Notifications
                </h1>

                <p class="text-slate-500 mt-2 text-base">
                    Stay updated with your appointments and important updates.
                </p>

            </div>

            <!-- Notifications -->

            <% if (notifications.length===0) { %>

                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-8 text-center">

                    <div
                        class="w-14 h-14 mx-auto rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-5">

                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">

                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />

                        </svg>

                    </div>

                    <h2 class="text-xl font-bold text-slate-800">
                        No notifications
                    </h2>

                    <p class="text-slate-500 mt-2">
                        You don't have any notifications yet.
                    </p>

                </div>

                <% } else { %>

                    <div class="space-y-4">

                        <% notifications.forEach(notification=> { %>

                            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">

                                <p class="text-slate-700">
                                    <%= notification.message %>
                                </p>

                                <% if (!notification.isRead) { %>

                                    <form action="/doctors/notifications/<%= notification._id %>/read" method="POST"
                                        class="mt-3">

                                        <button type="submit"
                                            class="text-sm text-indigo-600 font-semibold hover:text-indigo-800">
                                            Mark as read
                                        </button>

                                    </form>

                                    <% } else { %>

                                        <p class="text-sm text-green-600 font-semibold mt-3">
                                            Read
                                        </p>

                                        <% } %>

                            </div>

                            <% }) %>

                    </div>

                    <% } %>

        </div>

    </div>

    <%- include("../partials/footer") %>