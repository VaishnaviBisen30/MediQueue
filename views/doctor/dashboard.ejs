<%- include("./partials/doctorHeader") %>

    <% const slotsLink=availability.length> 0
        ? `/doctors/availability/${availability[0].day}/slots`
        : "/doctors/availability";
        %>

        <div class="min-h-[calc(100vh-4rem)] bg-slate-50">
            <div class="max-w-6xl mx-auto px-6 py-12">

                <!-- Header -->
                <div class="mb-10 flex items-start justify-between gap-4">

                    <div>
                        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                            Doctor Dashboard
                        </h1>

                        <p class="text-slate-500 mt-2 text-base">
                            Welcome to your MediQueue dashboard.
                        </p>
                    </div>

                    <!-- Notification Bell -->
                    <a href="/doctors/notifications" class="relative shrink-0 inline-flex items-center justify-center
               w-12 h-12 rounded-full bg-white border border-slate-200
               text-slate-600 hover:text-indigo-600 hover:bg-indigo-50
               hover:border-indigo-200 transition" title="Notifications" aria-label="View notifications">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 0 0-4.5-5.8V5a1.5 1.5 0 0 0-3 0v.2A6 6 0 0 0 6 11v3.2a2 2 0 0 1-.6 1.4L4 17h5m6 0a3 3 0 0 1-6 0" />
                        </svg>

                        <% if (typeof unreadNotifications !=="undefined" && unreadNotifications> 0) { %>
                            <span class="absolute -top-1 -right-1 min-w-5 h-5 px-1
                   flex items-center justify-center rounded-full
                   bg-red-500 text-white text-xs font-bold">
                                <%= unreadNotifications> 99 ? "99+" : unreadNotifications %>
                            </span>
                            <% } %>
                    </a>

                </div>

                <!-- Dashboard Action Cards -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                    <!-- Profile -->
                    <a href="/doctors/profile" class="group bg-white p-7 rounded-2xl border border-slate-200/80
               shadow-xs hover:shadow-md hover:border-blue-200
               hover:-translate-y-1 transition-all duration-200
               flex flex-col justify-between">
                        <div>
                            <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-600
                   flex items-center justify-center mb-6
                   group-hover:bg-blue-600 group-hover:text-white
                   transition-colors duration-200">
                                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </div>

                            <h2 class="text-xl font-bold text-slate-800 group-hover:text-blue-600 transition-colors">
                                My Profile
                            </h2>

                            <p class="text-slate-500 mt-2 text-sm leading-relaxed">
                                View and manage your doctor profile.
                            </p>
                        </div>

                        <div class="mt-6 flex items-center gap-1.5 text-xs font-semibold text-blue-600">
                            <span>Manage profile</span>
                            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 5l7 7-7 7" />
                            </svg>
                        </div>
                    </a>

                    <!-- Availability -->
                    <a href="/doctors/availability" class="group bg-white p-7 rounded-2xl border border-slate-200/80
               shadow-xs hover:shadow-md hover:border-teal-200
               hover:-translate-y-1 transition-all duration-200
               flex flex-col justify-between">
                        <div>
                            <div class="w-14 h-14 rounded-2xl bg-teal-50 text-teal-600
                   flex items-center justify-center mb-6
                   group-hover:bg-teal-600 group-hover:text-white
                   transition-colors duration-200">
                                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>

                            <h2 class="text-xl font-bold text-slate-800 group-hover:text-teal-600 transition-colors">
                                Availability
                            </h2>

                            <p class="text-slate-500 mt-2 text-sm leading-relaxed">
                                Manage your working days and timings.
                            </p>
                        </div>

                        <div class="mt-6 flex items-center gap-1.5 text-xs font-semibold text-teal-600">
                            <span>Set schedule</span>
                            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 5l7 7-7 7" />
                            </svg>
                        </div>
                    </a>

                    <!-- My Appointments -->
                    <a href="/doctors/appointments" class="group bg-white p-7 rounded-2xl border border-slate-200/80
               shadow-xs hover:shadow-md hover:border-indigo-200
               hover:-translate-y-1 transition-all duration-200
               flex flex-col justify-between">
                        <div>
                            <div class="w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-600
                   flex items-center justify-center mb-6
                   group-hover:bg-indigo-600 group-hover:text-white
                   transition-colors duration-200">
                                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M8 7V3m8 4V3M5 11h14M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>

                            <h2 class="text-xl font-bold text-slate-800 group-hover:text-indigo-600 transition-colors">
                                My Appointments
                            </h2>

                            <p class="text-slate-500 mt-2 text-sm leading-relaxed">
                                View patient bookings, appointment dates, and consultation times.
                            </p>
                        </div>

                        <div class="mt-6 flex items-center gap-1.5 text-xs font-semibold text-indigo-600">
                            <span>View appointments</span>
                            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 5l7 7-7 7" />
                            </svg>
                        </div>
                    </a>

                </div>
            </div>
        </div>

        <%- include("../partials/footer") %>